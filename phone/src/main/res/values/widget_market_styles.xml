<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="phone_market_widget_label">息屏行情</string>
    <string name="phone_market_widget_description">现价、涨跌幅、日高低、分时或一分钟 K 线</string>
    <string name="phone_market_chart_description">行情图</string>
    <!-- Keep previous resource IDs allocated so installed hosts inflate the revised layout on upgrade. -->
    <item name="phone_market_widget" type="layout">@layout/phone_market_widget_v3</item>
    <item name="phone_market_widget_v2" type="layout">@layout/phone_market_widget_v3</item>
    <style name="WidgetMarketLine">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
