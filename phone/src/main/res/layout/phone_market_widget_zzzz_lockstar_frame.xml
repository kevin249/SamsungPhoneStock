<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal">
        <FrameLayout android:id="@+id/widget_zzzz_presentation_measure"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="invisible" android:importantForAccessibility="no" />
        <FrameLayout android:id="@+id/widget_zzzz_presentation_content"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_alignLeft="@id/widget_zzzz_presentation_measure"
            android:layout_alignRight="@id/widget_zzzz_presentation_measure"
            android:layout_alignTop="@id/widget_zzzz_presentation_measure"
            android:layout_alignBottom="@id/widget_zzzz_presentation_measure" />
    </RelativeLayout>
</FrameLayout>
