<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dual_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@android:color/transparent">
    <FrameLayout android:id="@+id/widget_upper_slot" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
    <ImageView android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#5577869b" android:contentDescription="@null" />
    <FrameLayout android:id="@+id/widget_lower_slot" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
